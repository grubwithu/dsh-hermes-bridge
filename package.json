{
  "name": "dsh-hermes-bridge",
  "version": "0.1.0",
  "description": "Bidirectional bridge between DeepSeek Harness (DSH) and Hermes Agent for remote Telegram supervision and control.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "hermes",
    "scripts",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "pack:tgz": "npm run build && npm pack",
    "test": "tsc -p tsconfig.json && node --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5 || >=0.2.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5 || >=0.2.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5 || >=0.2.2",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.5 || >=0.2.2",
    "@deepseek-ai/dsh-user-questions": "0.2.2-rc.5 || >=0.2.2",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
